# Copy to backend/.env and fill in. This file is the only place the key lives —
# it is never sent to the frontend.
#
# Settings are namespaced COACH_* because bare names like CLAUDE_MODEL and
# CLAUDE_EFFORT are used by other tooling and would silently override these.
# ANTHROPIC_API_KEY is the one exception: it's read unprefixed too, since hosting
# platforms set it by convention.

ANTHROPIC_API_KEY=sk-ant-...

# Sonnet for real coaching conversation (per the build spec).
COACH_CLAUDE_MODEL=claude-sonnet-5
COACH_CLAUDE_SUMMARY_MODEL=claude-sonnet-5

# low | medium | high | xhigh | max — how much the model deliberates before replying.
# "low" keeps replies fast enough to feel conversational; raise it if the coaching
# feels shallow.
COACH_CLAUDE_EFFORT=low
COACH_CLAUDE_MAX_TOKENS=2048

# How many past session recaps get loaded into context.
COACH_RECENT_SUMMARY_COUNT=8

# SQLite by default; point at Postgres later without code changes.
# COACH_DATABASE_URL=sqlite:///./coach.db

# Vite dev server origins. Set to "" in production when the API serves the built PWA.
COACH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Copy to backend/.env and fill in. This file is the only place the key lives —
# it is never sent to the frontend.
#
# Settings are namespaced COACH_* because bare names like CLAUDE_MODEL and
# CLAUDE_EFFORT are used by other tooling and would silently override these.
# ANTHROPIC_API_KEY is the one exception: it's read unprefixed too, since hosting
# platforms set it by convention.

ANTHROPIC_API_KEY=sk-ant-...

# Sonnet for real coaching conversation (per the build spec).
COACH_CLAUDE_MODEL=claude-sonnet-5
COACH_CLAUDE_SUMMARY_MODEL=claude-sonnet-5

# low | medium | high | xhigh | max — how much the model deliberates before replying.
# "low" keeps replies fast enough to feel conversational; raise it if the coaching
# feels shallow.
COACH_CLAUDE_EFFORT=low
COACH_CLAUDE_MAX_TOKENS=2048

# How many past session recaps get loaded into context.
COACH_RECENT_SUMMARY_COUNT=8

# How long after a delete you can still tap/say "undo". Deleted rows are soft-deleted
# and never purged, so this bounds the undo affordance, not recoverability.
COACH_UNDO_WINDOW_SECONDS=300

# --- Voice ---
# Speech-to-text is the phone's own engine — free, nothing to configure.
# This is the "human voice" half. With no key set, the app silently uses the browser's
# built-in voice, so leaving this blank is a valid setup.
#
# auto (default) prefers ElevenLabs, then OpenAI. Pin one, or "none" to disable.
COACH_TTS_PROVIDER=auto

# ElevenLabs — swap the voice id for one of yours.
# ELEVENLABS_API_KEY=
# COACH_ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# COACH_ELEVENLABS_MODEL=eleven_flash_v2_5

# OpenAI
# OPENAI_API_KEY=
# COACH_OPENAI_TTS_MODEL=gpt-4o-mini-tts
# COACH_OPENAI_TTS_VOICE=alloy

# Where the SQLite file lives. Locally this defaults to backend/coach.db.
# IN PRODUCTION this must be a mounted volume, or every redeploy wipes your data.
# COACH_DATA_DIR=/data

# Overrides the above entirely — e.g. Postgres. Needs a driver:
#   pip install "psycopg[binary]"   and   postgresql+psycopg://user:pass@host/db
# COACH_DATABASE_URL=

# Vite dev server origins. Set to "" in production when the API serves the built PWA.
COACH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
